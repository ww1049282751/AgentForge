{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.local/schemas/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "brand",
    "repositoryName",
    "repository",
    "cliName",
    "pluginPrefix",
    "defaultChannel",
    "runtimeVersion",
    "supportedSchemaVersions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "repositoryName": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "cliName": {
      "type": "string",
      "minLength": 1
    },
    "pluginPrefix": {
      "const": "af-"
    },
    "defaultChannel": {
      "const": "stable"
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 5
    },
    "supportedSchemaVersions": {
      "type": "array",
      "items": {
        "const": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
