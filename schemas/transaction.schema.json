{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.local/schemas/transaction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "targetRoot",
    "phase",
    "before",
    "after",
    "names",
    "backupFiles",
    "candidateFiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "targetRoot": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "planned",
        "staged",
        "backed_up",
        "switching",
        "committed",
        "restoring",
        "rolled_back",
        "recovery_required"
      ]
    },
    "before": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "lock"
      ],
      "properties": {
        "state": {
          "anyOf": [
            {
              "$ref": "state.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "lock": {
          "anyOf": [
            {
              "$ref": "lock.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "after": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "lock"
      ],
      "properties": {
        "state": {
          "anyOf": [
            {
              "$ref": "state.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "lock": {
          "anyOf": [
            {
              "$ref": "lock.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "backupFiles": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          {
            "const": "directory"
          }
        ]
      }
    },
    "candidateFiles": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          {
            "const": "directory"
          }
        ]
      }
    }
  }
}
