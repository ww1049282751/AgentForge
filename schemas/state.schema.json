{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.local/schemas/state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "targetRoot",
    "roots",
    "lock",
    "exports",
    "lastTransaction",
    "previousTransaction"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "enum": [
        "project",
        "user"
      ]
    },
    "targetRoot": {
      "type": "string",
      "minLength": 1
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "source",
          "channel",
          "permissions"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "enum": [
              "stable",
              "preview"
            ]
          },
          "permissions": {
            "$ref": "package.schema.json#/$defs/permissions"
          }
        }
      }
    },
    "lock": {
      "$ref": "lock.schema.json"
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "skillKey",
          "files",
          "owners"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "skillKey": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "const": "directory"
                }
              ]
            }
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "lastTransaction": {
      "type": [
        "string",
        "null"
      ]
    },
    "previousTransaction": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
