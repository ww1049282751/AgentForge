{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.local/schemas/package.schema.json",
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "plugin",
            "skill"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "revision",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "workspace",
            "git"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "git"
              }
            }
          },
          "then": {
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^https://github.com/[^/]+/[^/]+$"
              },
              "revision": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            }
          }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "writes",
        "exec"
      ],
      "properties": {
        "network": {
          "type": "boolean"
        },
        "writes": {
          "enum": [
            "none",
            "user-selected-output"
          ]
        },
        "exec": {
          "const": false
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeMajor",
        "platforms",
        "hosts",
        "requiredCapabilities"
      ],
      "properties": {
        "runtimeMajor": {
          "type": "integer",
          "minimum": 0
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "windows",
              "macos",
              "linux"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "adapter",
              "testedVersions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "adapter": {
                "type": "string",
                "minLength": 1
              },
              "testedVersions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "minItems": 1
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "enum": [
              "instructions",
              "local-files",
              "web-research"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "description",
        "version",
        "channel",
        "dependencies",
        "source",
        "permissions",
        "compatibility",
        "displayName",
        "skills"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "plugin"
        },
        "id": {
          "type": "string",
          "pattern": "^af-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 5
        },
        "channel": {
          "enum": [
            "stable",
            "preview"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/dependency"
          }
        },
        "source": {
          "$ref": "package.schema.json#/$defs/source"
        },
        "permissions": {
          "$ref": "package.schema.json#/$defs/permissions"
        },
        "compatibility": {
          "$ref": "package.schema.json#/$defs/compatibility"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "version": {
                "type": "string",
                "minLength": 5
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "description",
        "version",
        "channel",
        "dependencies",
        "source",
        "permissions",
        "compatibility",
        "entry"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "skill"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 5
        },
        "channel": {
          "enum": [
            "stable",
            "preview"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/dependency"
          }
        },
        "source": {
          "$ref": "package.schema.json#/$defs/source"
        },
        "permissions": {
          "$ref": "package.schema.json#/$defs/permissions"
        },
        "compatibility": {
          "$ref": "package.schema.json#/$defs/compatibility"
        },
        "entry": {
          "const": "SKILL.md"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "package.schema.json#/$defs/plugin"
    },
    {
      "$ref": "package.schema.json#/$defs/skill"
    }
  ]
}
