{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.local/schemas/adapter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "host",
    "namePrefix",
    "discoveryPath",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "host": {
      "const": "codex"
    },
    "namePrefix": {
      "const": "af-"
    },
    "discoveryPath": {
      "const": ".agents/skills"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "instructions",
          "local-files"
        ]
      },
      "uniqueItems": true
    }
  }
}
